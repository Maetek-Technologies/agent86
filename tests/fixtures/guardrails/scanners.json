{
 "patterns": {
  "_INJECTION": [
   {
    "pattern": "\\bignore\\s+(all\\s+|the\\s+|any\\s+)?(previous|prior|above)\\s+(instructions|prompts?|messages?)",
    "ignore_case": true,
    "label": "override-instructions"
   },
   {
    "pattern": "\\bdisregard\\s+(the\\s+|all\\s+)?(above|previous|prior)",
    "ignore_case": true,
    "label": "override-instructions"
   },
   {
    "pattern": "\\byou\\s+are\\s+now\\b",
    "ignore_case": true,
    "label": "role-reassignment"
   },
   {
    "pattern": "\\b(developer|dan|jailbreak)\\s+mode\\b",
    "ignore_case": true,
    "label": "jailbreak"
   },
   {
    "pattern": "\\b(reveal|print|show|repeat)\\s+(your|the)\\s+(system\\s+)?(prompt|instructions)",
    "ignore_case": true,
    "label": "prompt-extraction"
   },
   {
    "pattern": "\\bnew\\s+(system\\s+)?(instructions?|rules?)\\s*:",
    "ignore_case": true,
    "label": "instruction-injection"
   },
   {
    "pattern": "\\bexfiltrat",
    "ignore_case": true,
    "label": "exfiltration"
   }
  ],
  "_SECRETS": [
   {
    "pattern": "sk-ant-[A-Za-z0-9_\\-]{20,}",
    "ignore_case": false,
    "label": "anthropic-key"
   },
   {
    "pattern": "\\bsk-[A-Za-z0-9]{20,}\\b",
    "ignore_case": false,
    "label": "openai-key"
   },
   {
    "pattern": "\\bAKIA[0-9A-Z]{16}\\b",
    "ignore_case": false,
    "label": "aws-access-key"
   },
   {
    "pattern": "\\bghp_[A-Za-z0-9]{36}\\b",
    "ignore_case": false,
    "label": "github-token"
   },
   {
    "pattern": "-----BEGIN (?:RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----",
    "ignore_case": false,
    "label": "private-key"
   },
   {
    "pattern": "(?i)\\b(api[_-]?key|secret|token|password|passwd)\\b\\s*[:=]\\s*['\\\"]?[A-Za-z0-9_\\-]{12,}",
    "ignore_case": false,
    "label": "credential-assignment"
   }
  ],
  "_PII": [
   {
    "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
    "ignore_case": false,
    "label": "email"
   },
   {
    "pattern": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
    "ignore_case": false,
    "label": "ssn"
   },
   {
    "pattern": "\\b(?:\\+?1[-.\\s]?)?\\(?\\d{3}\\)?[-.\\s]?\\d{3}[-.\\s]?\\d{4}\\b",
    "ignore_case": false,
    "label": "phone"
   },
   {
    "pattern": "\\b(?:\\d[ -]?){13,16}\\b",
    "ignore_case": false,
    "label": "card-number"
   }
  ]
 },
